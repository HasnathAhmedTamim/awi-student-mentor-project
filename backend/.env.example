NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL. With Neon, DATABASE_URL is the pooled URL (host contains "-pooler")
# and DIRECT_URL is the direct URL used by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Initial mentor account created by `npm run db:seed`
SEED_MENTOR_NAME="Mentor"
SEED_MENTOR_EMAIL="mentor@example.com"
SEED_MENTOR_PASSWORD="change-me-to-a-strong-password"

# Optional demo data seed. Keep unset unless using a disposable Neon development branch.
# When explicitly enabled, the seed accepts only a *.neon.tech host and database neondb.
# SEED_ALLOW_NEON_DEMO=true
# SEED_DEMO_STUDENT_PASSWORD="change-me-to-a-demo-student-password"

# Auth. Generate a secret with: openssl rand -hex 48
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN_SECONDS=86400
# Number of proxies in front of the API (the Next.js rewrite proxy)
TRUST_PROXY=1
