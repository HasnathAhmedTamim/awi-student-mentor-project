# Copy to .env.test. Tests DELETE all data in this database, so it must be a
# local, throwaway database (the test setup refuses non-local hosts).
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/awi_test"
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/awi_test"
JWT_SECRET="test-secret-that-is-at-least-32-characters-long"
